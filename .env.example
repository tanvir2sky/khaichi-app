# Public site URL (used for canonical links, sitemap, share links). No trailing slash.
VITE_SITE_URL=https://amikheyechi.com

# Optional: Supabase district leaderboard. Leave empty to hide the leaderboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Cloudflare Turnstile site key, used as captcha for anonymous sign-in (enable captcha in Supabase Auth too).
VITE_TURNSTILE_SITE_KEY=

# Optional: PostHog analytics (project API key). Host defaults to https://us.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Optional: Google Form (or any URL) for "ভুল ধরিয়ে দিন" corrections
VITE_FEEDBACK_URL=
